    "admin:create": "tsx scripts/create-admin.ts",
    "test:booking": "node --conditions=react-server --import tsx scripts/test-booking.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.13",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
