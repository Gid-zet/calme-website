# Copy to .env.local for local overrides, and set these in your host for production.

# ── Database ─────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, RDS, etc.). Must allow the btree_gist extension.
# Leave unset locally to use the embedded database in .data/pglite (no install needed).
DATABASE_URL=
# DATABASE_POOL_SIZE=10

# ── App ──────────────────────────────────────────────────────────────────
# Public base URL, used in email links. Required in production.
APP_URL=http://localhost:3000

# ── Email (Resend) ───────────────────────────────────────────────────────
# Without these, emails in development are written to .data/outbox and printed to the console.
# In production they are REQUIRED for verification, password reset, invites and booking emails.
RESEND_API_KEY=
EMAIL_FROM="CalMe <no-reply@your-verified-domain>"

# ── Scheduled jobs ───────────────────────────────────────────────────────
# Shared secret for GET /api/cron/reminders (24h reminders + releasing stale requests).
CRON_SECRET=
